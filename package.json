{
  "name": "my-static-server-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin-based starter for building a static leaderboard/activity site from multiple data sources",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "data:setup": "cd packages/plugin-runner && tsx src/index.ts setup",
    "data:import": "cd packages/plugin-runner && tsx src/index.ts import",
    "data:scrape": "cd packages/plugin-runner && tsx src/index.ts scrape",
    "data:aggregate": "cd packages/plugin-runner && tsx src/index.ts aggregate",
    "data:evaluate": "cd packages/plugin-runner && tsx src/index.ts evaluate",
    "data:export": "cd packages/plugin-runner && tsx src/index.ts export",
    "db:seed": "pnpm --filter @starter/leaderboard-api seed",
    "build:packages": "pnpm --filter @starter/leaderboard-api build && pnpm --filter @starter/plugin-runner build && pnpm --filter @starter/plugin-dummy build && pnpm --filter create-starter-plugin build && pnpm --filter create-starter-data-repo build && pnpm --filter @starter/mcp-server build",
    "build:data": "cd packages/plugin-runner && tsx src/index.ts",
    "build:web": "pnpm --filter @starter/web build",
    "build": "pnpm build:packages && pnpm build:data && pnpm build:web",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "setup:dev": "tsx scripts/setup-dev.ts",
    "clean:dev": "rm -rf data/",
    "reset:dev": "pnpm clean:dev && pnpm setup:dev",
    "dev": "pnpm --filter @starter/web dev",
    "mcp": "pnpm --filter @starter/mcp-server dev",
    "create-data-repo": "tsx packages/create-data-repo/src/index.ts",
    "create-plugin": "tsx packages/create-plugin/src/index.ts",
    "generate:schema": "tsx scripts/generate-config-schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "leaderboard",
    "static-site",
    "plugin",
    "starter"
  ],
  "packageManager": "pnpm@10.33.0",
  "author": "Open Healthcare Network",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write",
    "*.{json,yaml,yml,md,mdx,css,html}": "prettier --write"
  },
  "dependencies": {
    "create-starter-data-repo": "link:packages/create-data-repo",
    "create-starter-plugin": "link:packages/create-plugin"
  }
}
