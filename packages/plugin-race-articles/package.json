{
  "name": "@starter/plugin-race-articles",
  "version": "0.1.0",
  "description": "Rule-based plugin that turns offline-fetched race announcement articles into race/event organizers and per-distance-category races",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "leaderboard",
    "plugin",
    "race",
    "trail-running",
    "scraper"
  ],
  "author": "Open Healthcare Network",
  "license": "MIT",
  "dependencies": {
    "@starter/leaderboard-api": "workspace:*",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
